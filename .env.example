# Scripts read process environment variables; export these in your shell or hosting settings.
# Local development: npm run dev creates demo data in data/demo.
# Production: npm run build, then npm start (never set CHAO_DEMO=1 publicly).
PORT=3001
DATA_DIR=./data/production
# Set securely on first production start (minimum 10 characters).
# BOOTSTRAP_ADMIN_PASSWORD=
# For packaged mobile apps, rebuild using your public HTTPS API origin.
# VITE_API_URL=https://your-api.example.com
# Allow the Capacitor WebView origins on the API server.
ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost
